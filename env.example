# Optional external SearXNG instance. Leave this commented out for automatic
# local SearXNG management, or set it when SearXNG is managed separately.
# JSON output must be enabled on an external instance.
# SEARXNG_URL=http://127.0.0.1:8080

# Local SearXNG settings (used when SEARXNG_URL is unset). The default prefers
# an installed SearXNG Python module and otherwise uses Docker.
# SEARXNG_BACKEND=auto
# SEARXNG_DOCKER_IMAGE=docker.io/searxng/searxng:latest
# SEARXNG_STARTUP_TIMEOUT_SECONDS=120
# ENV_FILE=/path/to/another/.env

# API server
HOST=0.0.0.0
PORT=3000

# Retrieval limits
HTTP_CONCURRENCY=10
BROWSER_CONCURRENCY=3
PAGE_TIMEOUT_SECONDS=15
SEARCH_TIMEOUT_SECONDS=10
BROWSER_TIMEOUT_MS=20000
BROWSER_SETTLE_MS=750
MAX_PAGE_BYTES=5242880
MIN_TEXT_LENGTH=300

# Safety: by default, retrieved search-result URLs may not resolve to
# localhost/private/link-local addresses.
ALLOW_PRIVATE_URLS=false
