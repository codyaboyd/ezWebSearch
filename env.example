# SearXNG instance. JSON output must be enabled in SearXNG.
SEARXNG_URL=http://127.0.0.1:8080

# API server
HOST=0.0.0.0
PORT=3000

# Retrieval limits
HTTP_CONCURRENCY=10
BROWSER_CONCURRENCY=3
PAGE_TIMEOUT_SECONDS=15
SEARCH_TIMEOUT_SECONDS=10
BROWSER_TIMEOUT_MS=20000
BROWSER_SETTLE_MS=750
MAX_PAGE_BYTES=5242880
MIN_TEXT_LENGTH=300

# Safety: by default, retrieved search-result URLs may not resolve to
# localhost/private/link-local addresses.
ALLOW_PRIVATE_URLS=false
